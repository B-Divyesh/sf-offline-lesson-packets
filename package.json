{
  "name": "offline-lesson-packets",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src tests vite.config.ts playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run && playwright test",
    "test:unit": "npm run build && vitest run",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "^24.3.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
